NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/flowforge-ai
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT Configuration
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=flowforge-ai
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# SMTP Configuration (optional — server runs without these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@flowforge.local
